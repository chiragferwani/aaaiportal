---
import { Sprout, ShieldCheck, Zap, BarChart3, HeartPulse, ExternalLink } from "@lucide/astro";

const evaluatorThemes = [
  {
    id: 1,
    evaluator: "Evaluator 01",
    theme: "Agriculture",
    status: "Dataset Live",
    datasetUrl: "https://drive.google.com/drive/folders/1qXGa-AxFExQ-eAefM8g8BK2FDZ9lX1YX?usp=sharing",
    icon: Sprout,
    bgGradient: "from-emerald-500 to-teal-700",
    textColor: "text-white",
    subColor: "text-emerald-100",
  },
  {
    id: 2,
    evaluator: "Evaluator 02",
    theme: "Defence",
    status: "Dataset Live",
    datasetUrl: "https://drive.google.com/drive/folders/15e55ab8Aw9ONGpww1_DagAfBaGccTshH?usp=drive_link",
    icon: ShieldCheck,
    bgGradient: "from-blue-600 to-indigo-800",
    textColor: "text-white",
    subColor: "text-blue-100",
  },
  {
    id: 3,
    evaluator: "Evaluator 03",
    theme: "Energy",
    status: "Dataset Live",
    datasetUrl: "https://drive.google.com/drive/folders/1C_ImoGJ5GwMywDVXw7womK5M_VlNo8dT?usp=drive_link",
    icon: Zap,
    bgGradient: "from-amber-500 to-yellow-700", // Center featured card
    textColor: "text-white",
    subColor: "text-amber-100",
  },
  {
    id: 4,
    evaluator: "Evaluator 04",
    theme: "Finance",
    status: "Dataset Live",
    datasetUrl: "https://drive.google.com/drive/folders/1bKXK9FnodYBYXXfi_uQF0PWPI36cZzS9?usp=drive_link",
    icon: BarChart3,
    bgGradient: "from-sky-500 to-blue-700",
    textColor: "text-white",
    subColor: "text-sky-100",
  },
  {
    id: 5,
    evaluator: "Evaluator 05",
    theme: "Healthcare",
    status: "Dataset Live",
    datasetUrl: "https://drive.google.com/drive/folders/1BCjl5Lx61W85gBl9XciM5Tfetuq421aP?usp=drive_link",
    icon: HeartPulse,
    bgGradient: "from-rose-500 to-red-700",
    textColor: "text-white",
    subColor: "text-rose-100",
  },
];

// Center card (Energy / Evaluator 03) is featured on top; others spread around it
const featured = evaluatorThemes[2];
const others = [evaluatorThemes[0], evaluatorThemes[1], evaluatorThemes[3], evaluatorThemes[4]];
---

<div class="eval-stack-wrapper py-8 overflow-hidden md:overflow-visible">
  <div class="eval-stack-list">
    <!-- Featured Center Card (Evaluator 03) -->
    <a
      href={featured.datasetUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="eval-stack-item eval-stack-featured group/card"
      title={`Open ${featured.theme} Dataset`}
    >
      <div class={`eval-stack-card bg-gradient-to-br ${featured.bgGradient} ${featured.textColor}`}>
        <!-- Evaluator Profile Header -->
        <div class="flex flex-col items-center gap-2 pt-4">
          <div class="w-14 h-14 rounded-full bg-white/20 backdrop-blur-md border border-white/35 flex items-center justify-center shadow-inner group-hover/card:scale-110 transition-transform">
            <featured.icon class="w-7 h-7 text-white" />
          </div>
          <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-white/20 backdrop-blur-md shadow-sm">
            {featured.evaluator}
          </span>
        </div>

        <!-- Theme Listed at Bottom Center -->
        <div class="mt-auto w-full text-center pb-4 pt-6 border-t border-white/25">
          <h4 class="text-base font-bold tracking-tight flex items-center justify-center gap-1">
            {featured.theme} <ExternalLink size={14} class="opacity-80" />
          </h4>
          <span class={`text-xs ${featured.subColor} font-medium block mt-0.5`}>{featured.status}</span>
        </div>
      </div>
    </a>

    <!-- Spreading Side Cards -->
    {others.map((item, index) => (
      <a
        href={item.datasetUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="eval-stack-item eval-stack-other group/card"
        style={`--i: ${index + 1}; --total: 5; --spread: ${[1.15, 1.45, 1.45, 1.15][index]};`}
        title={`Open ${item.theme} Dataset`}
      >
        <div class={`eval-stack-card bg-gradient-to-br ${item.bgGradient} ${item.textColor}`}>
          <!-- Evaluator Profile Header -->
          <div class="flex flex-col items-center gap-2 pt-4">
            <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-md border border-white/35 flex items-center justify-center shadow-inner group-hover/card:scale-110 transition-transform">
              <item.icon class="w-6 h-6" />
            </div>
            <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-white/20 backdrop-blur-md shadow-sm">
              {item.evaluator}
            </span>
          </div>

          <!-- Theme Listed at Bottom Center -->
          <div class="mt-auto w-full text-center pb-4 pt-4 border-t border-white/25">
            <h4 class="text-sm font-bold tracking-tight flex items-center justify-center gap-1">
              {item.theme} <ExternalLink size={12} class="opacity-80" />
            </h4>
            <span class={`text-[11px] ${item.subColor} font-medium block mt-0.5`}>{item.status}</span>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .eval-stack-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .eval-stack-list {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 350px;
    width: 100%;
    max-width: 1100px;
  }

  .eval-stack-item {
    position: relative;
    width: 215px;
    height: 295px;
    border-radius: 22px;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.5s cubic-bezier(0.34, 1.2, 0.64, 1),
                box-shadow 0.35s ease;
  }

  /* ── Desktop Hover Stack Effect ── */
  @media (min-width: 768px) {
    .eval-stack-featured {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      z-index: 50;
    }

    /* Initial state for side cards: visible offset so all 5 evaluators are seen */
    .eval-stack-other {
      position: absolute;
      left: 50%;
      transform: translateX(-50%)
                 translateX(calc((var(--i) - 2.5) * 110px))
                 rotate(calc((var(--i) - 2.5) * 5deg));
      z-index: calc(10 - var(--i));
    }

    /* Hover state: widen spread significantly so all cards are completely visible */
    .eval-stack-list:hover .eval-stack-featured {
      transform: translateX(-50%) translateY(-20px) scale(1.05);
      z-index: 200;
    }

    .eval-stack-list:hover .eval-stack-featured:hover {
      z-index: 999;
    }

    .eval-stack-list:hover .eval-stack-other {
      transform: translateX(-50%)
                 translateX(calc((var(--i) - 2.5) * var(--spread) * 205px))
                 rotate(calc((var(--i) - 2.5) * 7deg));
      z-index: calc(var(--i) + 50);
    }

    .eval-stack-list:hover .eval-stack-other:hover {
      transform: translateX(-50%)
                 translateX(calc((var(--i) - 2.5) * var(--spread) * 200px))
                 translateY(-18px)
                 rotate(calc((var(--i) - 2.5) * 8deg))
                 scale(1.08);
      z-index: 999;
    }
  }

  /* ── Mobile Layout ── */
  @media (max-width: 767px) {
    .eval-stack-list {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      height: auto;
      justify-content: center;
    }
    .eval-stack-item {
      position: relative;
      transform: none !important;
      width: 155px;
      height: 220px;
    }
  }

  /* ── Card Styling ── */
  .eval-stack-card {
    width: 100%;
    height: 100%;
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1rem 0.75rem 1rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .eval-stack-item:hover .eval-stack-card {
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.28);
    border-color: rgba(255, 255, 255, 0.7);
  }
</style>
