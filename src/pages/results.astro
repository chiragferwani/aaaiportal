---
import PageHeader from "@/components/elements/PageHeader.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Layout from "@/layouts/Layout.astro";
import { ArrowLeft, Award, Layers, Star, Trophy } from "@lucide/astro";
---

<Layout title="Results — RAG Hackathon" description="Final standings and scores from the Day 4 RAG Hackathon.">
  <div class="pt-8 pb-16 md:pb-24">
    <PageHeader
      title="Results"
      description="Final standings and scores from the Day 4 RAG Hackathon."
    />

    <section class="site-container">
      <div class="max-w-4xl mx-auto">

        <!-- COMING SOON CONTAINER (Default) -->
        <div id="coming-soon-container" class="rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 p-8 md:p-16 text-center mb-16 relative overflow-hidden">
          <!-- Background glow -->
          <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/5 rounded-full blur-3xl"></div>
          <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-accent/5 rounded-full blur-3xl"></div>

          <div class="relative z-10 flex flex-col items-center">
            <div class="w-24 h-24 bg-primary/10 dark:bg-primary/20 rounded-full flex items-center justify-center mb-6">
              <Trophy class="w-12 h-12 text-primary" />
            </div>

            <h2 class="text-4xl md:text-5xl font-brand mb-4">Results Coming Soon</h2>
            <p class="text-neutral-600 dark:text-neutral-300 max-w-xl mx-auto mb-10 leading-relaxed">
              Results will be published here once all evaluations are complete. Stay tuned for the final standings.
            </p>

            <!-- Faded Table Placeholder -->
            <div class="w-full border border-dashed border-primary/15 dark:border-neutral-700 rounded-lg overflow-hidden opacity-50">
              <div class="grid grid-cols-5 gap-4 bg-primary/5 dark:bg-primary/10 p-4 border-b border-dashed border-primary/10 dark:border-neutral-700">
                <span class="text-left text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Rank</span>
                <span class="text-left col-span-2 text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Team</span>
                <span class="text-center text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider hidden sm:block">Status</span>
                <span class="text-right text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Award</span>
              </div>

              {[1, 2, 3, 4, 5].map((row) => (
                <div class="grid grid-cols-5 gap-4 p-4 border-b border-dashed border-primary/5 dark:border-neutral-800 last:border-b-0 items-center">
                  <span class="text-left font-brand text-lg text-neutral-400 dark:text-neutral-600">#{row.toString().padStart(2, '0')}</span>
                  <div class="col-span-2 flex items-center gap-2">
                    <div class="w-6 h-6 rounded-md bg-neutral-200 dark:bg-neutral-700 animate-pulse"></div>
                    <div class="h-3 bg-neutral-200 dark:bg-neutral-700 rounded w-20 animate-pulse"></div>
                  </div>
                  <span class="text-center text-sm text-neutral-400 dark:text-neutral-600 font-mono hidden sm:block">—</span>
                  <div class="flex justify-end">
                    <div class="h-5 bg-neutral-200 dark:bg-neutral-700 rounded-full w-16 animate-pulse"></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- PUBLISHED RESULTS CONTAINER (shown when admin publishes) -->
        <div id="published-results-container" class="hidden space-y-12 mb-16">
          <div class="text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-bold uppercase tracking-wider mb-4">
              🏆 Official Hackathon Winners
            </div>
            <h2 class="text-3xl md:text-5xl font-brand">Congratulations Winners!</h2>
            <p class="text-neutral-600 dark:text-neutral-300 mt-2">Here are the top performing teams of the AAAI RAG Hackathon.</p>
          </div>

          <!-- Winners Podium Grid -->
          <div id="podium-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Rendered dynamically by script -->
          </div>
        </div>

        <!-- What to Expect / Info -->
        <div class="mb-16">
          <h3 class="text-2xl font-brand text-center mb-8">Hackathon Highlights</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-6 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
              <Star class="w-7 h-7 text-accent mb-3" />
              <h4 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-2">Final Standings</h4>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">Official rankings verified by the AAAI Student Chapter evaluators.</p>
            </div>

            <div class="p-6 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
              <Award class="w-7 h-7 text-primary mb-3" />
              <h4 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-2">Technical Excellence</h4>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">Evaluated on retrieval precision, embedding quality, and chatbot responsiveness.</p>
            </div>

            <div class="p-6 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
              <Layers class="w-7 h-7 text-[#cd7f32] mb-3" />
              <h4 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-2">Theme Challenges</h4>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">Top solutions across Agriculture, Defence, Energy, Finance, and Healthcare tracks.</p>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="flex justify-center">
          <Button url="/" type="outline" size="lg"><ArrowLeft size={16} /> Return to Home</Button>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  (function () {
    const comingSoonContainer = document.getElementById("coming-soon-container");
    const publishedContainer = document.getElementById("published-results-container");
    const podiumGrid = document.getElementById("podium-grid");

    function renderResults() {
      const isPublished = localStorage.getItem("aaai_results_published") === "true";
      const winnersData = JSON.parse(localStorage.getItem("aaai_winners_data") || "{}");

      if (isPublished && (winnersData.first || winnersData.second || winnersData.third)) {
        comingSoonContainer.classList.add("hidden");
        publishedContainer.classList.remove("hidden");

        const cards = [];

        if (winnersData.first) {
          cards.push(`
            <div class="p-6 rounded-xl bg-gradient-to-b from-[#fad13b]/15 to-transparent border border-[#fad13b]/40 text-center flex flex-col justify-between shadow-lg relative overflow-hidden">
              <div class="absolute top-2 right-2 text-2xl">🥇</div>
              <div>
                <span class="text-xs font-bold text-[#fad13b] uppercase tracking-wider">1st Place Winner</span>
                <h3 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-2 mb-1">${winnersData.first}</h3>
                <span class="inline-block px-3 py-1 rounded-full bg-[#fad13b]/20 text-[#fad13b] text-xs font-bold mt-2">CHAMPION</span>
              </div>
            </div>
          `);
        }

        if (winnersData.second) {
          cards.push(`
            <div class="p-6 rounded-xl bg-gradient-to-b from-neutral-400/15 to-transparent border border-neutral-400/40 text-center flex flex-col justify-between shadow-md relative overflow-hidden">
              <div class="absolute top-2 right-2 text-2xl">🥈</div>
              <div>
                <span class="text-xs font-bold text-neutral-400 uppercase tracking-wider">2nd Place Winner</span>
                <h3 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-2 mb-1">${winnersData.second}</h3>
                <span class="inline-block px-3 py-1 rounded-full bg-neutral-400/20 text-neutral-300 text-xs font-bold mt-2">RUNNER UP</span>
              </div>
            </div>
          `);
        }

        if (winnersData.third) {
          cards.push(`
            <div class="p-6 rounded-xl bg-gradient-to-b from-[#cd7f32]/15 to-transparent border border-[#cd7f32]/40 text-center flex flex-col justify-between shadow-md relative overflow-hidden">
              <div class="absolute top-2 right-2 text-2xl">🥉</div>
              <div>
                <span class="text-xs font-bold text-[#cd7f32] uppercase tracking-wider">3rd Place Winner</span>
                <h3 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mt-2 mb-1">${winnersData.third}</h3>
                <span class="inline-block px-3 py-1 rounded-full bg-[#cd7f32]/20 text-[#cd7f32] text-xs font-bold mt-2">2ND RUNNER UP</span>
              </div>
            </div>
          `);
        }

        podiumGrid.innerHTML = cards.join("");
      } else {
        comingSoonContainer.classList.remove("hidden");
        publishedContainer.classList.add("hidden");
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", renderResults);
    } else {
      renderResults();
    }
  })();
</script>
