---
import PageHeader from "@/components/elements/PageHeader.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Layout from "@/layouts/Layout.astro";
import { ArrowLeft, Award, Layers, Star, Trophy } from "@lucide/astro";
---

<Layout title="Results — RAG Hackathon" description="Final standings and scores from the Day 4 RAG Hackathon.">
  <div class="pt-8 pb-16 md:pb-24">
    <PageHeader
      title="Results"
      description="Final standings and scores from the Day 4 RAG Hackathon."
    />

    <section class="site-container">
      <div class="max-w-4xl mx-auto">

        <!-- Coming Soon State -->
        <div class="rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 p-8 md:p-16 text-center mb-16 relative overflow-hidden" data-aos="fade-up-xs" data-aos-once="true">
          <!-- Background glow -->
          <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/5 rounded-full blur-3xl"></div>
          <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-accent/5 rounded-full blur-3xl"></div>

          <div class="relative z-10 flex flex-col items-center">
            <div class="w-24 h-24 bg-primary/10 dark:bg-primary/20 rounded-full flex items-center justify-center mb-6">
              <Trophy class="w-12 h-12 text-primary" />
            </div>

            <h2 class="text-4xl md:text-5xl font-brand mb-4">Results Coming Soon</h2>
            <p class="text-neutral-600 dark:text-neutral-300 max-w-xl mx-auto mb-10 leading-relaxed">
              Results will be published here once all evaluations are complete. Stay tuned for the final standings.
            </p>

            <!-- Faded Table Placeholder -->
            <div class="w-full border border-dashed border-primary/15 dark:border-neutral-700 rounded-lg overflow-hidden opacity-50">
              <div class="grid grid-cols-5 gap-4 bg-primary/5 dark:bg-primary/10 p-4 border-b border-dashed border-primary/10 dark:border-neutral-700">
                <span class="text-left text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Rank</span>
                <span class="text-left col-span-2 text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Team</span>
                <span class="text-center text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider hidden sm:block">Score</span>
                <span class="text-right text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">Award</span>
              </div>

              {[1, 2, 3, 4, 5].map((row) => (
                <div class="grid grid-cols-5 gap-4 p-4 border-b border-dashed border-primary/5 dark:border-neutral-800 last:border-b-0 items-center">
                  <span class="text-left font-brand text-lg text-neutral-400 dark:text-neutral-600">#{row.toString().padStart(2, '0')}</span>
                  <div class="col-span-2 flex items-center gap-2">
                    <div class="w-6 h-6 rounded-md bg-neutral-200 dark:bg-neutral-700 animate-pulse"></div>
                    <div class="h-3 bg-neutral-200 dark:bg-neutral-700 rounded w-20 animate-pulse"></div>
                  </div>
                  <span class="text-center text-sm text-neutral-400 dark:text-neutral-600 font-mono hidden sm:block">—</span>
                  <div class="flex justify-end">
                    <div class="h-5 bg-neutral-200 dark:bg-neutral-700 rounded-full w-16 animate-pulse"></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- What to Expect -->
        <div class="mb-16" data-aos="fade-up-xs" data-aos-once="true" data-aos-delay="100">
          <h3 class="text-2xl font-brand text-center mb-8">What to Expect</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="p-6 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
              <Star class="w-7 h-7 text-accent mb-3" />
              <h4 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-2">Final Rankings</h4>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">Complete standings across all five themes of the hackathon.</p>
            </div>

            <div class="p-6 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
              <Award class="w-7 h-7 text-primary mb-3" />
              <h4 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-2">Scores & Feedback</h4>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">Detailed evaluation scores and constructive feedback from theme evaluators.</p>
            </div>

            <div class="p-6 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
              <Layers class="w-7 h-7 text-[#cd7f32] mb-3" />
              <h4 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-2">Theme Winners</h4>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">Special recognition for top performers in each theme track.</p>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="flex justify-center" data-aos="fade-up-xs" data-aos-once="true" data-aos-delay="200">
          <Button url="/" type="outline" size="lg"><ArrowLeft size={16} /> Return to Home</Button>
        </div>
      </div>
    </section>
  </div>
</Layout>
