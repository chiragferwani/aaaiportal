---
import PageHeader from "@/components/elements/PageHeader.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Layout from "@/layouts/Layout.astro";
import {
	AlertCircle,
	CheckCircle,
	Clock,
	ExternalLink,
	FileText,
	Link,
	Lock,
	Send,
	ShieldAlert,
} from "@lucide/astro";
---

<Layout
  title="Submit Your Chatbot — RAG Hackathon"
  description="Submit the URL of your deployed RAG-powered chatbot for evaluation."
>
  <div class="pt-8 pb-16 md:pb-24">
    <PageHeader
      title="Submit Your Chatbot"
      description="Submit the URL of your deployed RAG-powered chatbot. Make sure your application is publicly accessible before submitting."
    />

    <div class="site-container max-w-3xl">
      <!-- Submission Form Card -->
      <div id="form-container" class="rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 p-6 md:p-10 mb-8" data-aos="fade-up-xs" data-aos-once="true">
        <form id="submission-form" class="space-y-6" onsubmit="return false;">

          <!-- Read-only Team Name -->
          <div>
            <label class="text-sm font-semibold text-neutral-700 dark:text-neutral-300 mb-2 block">Team Name</label>
            <input
              type="text"
              value="Team Alpha"
              disabled
              class="w-full rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 px-4 py-3 text-neutral-500 dark:text-neutral-400 cursor-not-allowed text-sm font-medium"
            />
          </div>

          <!-- Read-only Selected Theme -->
          <div>
            <label class="text-sm font-semibold text-neutral-700 dark:text-neutral-300 mb-2 block">Selected Theme</label>
            <input
              type="text"
              value="Coming Soon"
              disabled
              class="w-full rounded-lg border border-neutral-200 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 px-4 py-3 text-neutral-500 dark:text-neutral-400 cursor-not-allowed text-sm font-medium"
            />
          </div>

          <!-- Chatbot URL Input (Required) -->
          <div>
            <label for="chatbot-url" class="text-sm font-semibold text-neutral-700 dark:text-neutral-300 mb-2 flex items-center justify-between">
              <span>Chatbot Deployed URL <span class="text-red-500">*</span></span>
              <span class="text-xs font-normal text-neutral-400">Must be http:// or https://</span>
            </label>
            <div class="relative">
              <input
                type="url"
                id="chatbot-url"
                name="chatbot-url"
                required
                placeholder="https://your-rag-chatbot.vercel.app"
                class="w-full rounded-lg border border-neutral-300 dark:border-neutral-600 bg-bg-primary/50 dark:bg-bg-primary-dark/50 px-4 py-3 text-neutral-800 dark:text-neutral-100 text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none transition"
              />
            </div>
            <p id="url-error" class="hidden text-xs text-red-500 mt-1.5 flex items-center gap-1">
              <AlertCircle class="w-3.5 h-3.5 inline" /> Please enter a valid URL starting with http:// or https://
            </p>
          </div>

          <!-- Optional Project Name -->
          <div>
            <label for="project-name" class="text-sm font-semibold text-neutral-700 dark:text-neutral-300 mb-2 block">Project Name <span class="text-xs font-normal text-neutral-400">(Optional)</span></label>
            <input
              type="text"
              id="project-name"
              placeholder="e.g. DocuRAG Assistant"
              class="w-full rounded-lg border border-neutral-300 dark:border-neutral-600 bg-bg-primary/50 dark:bg-bg-primary-dark/50 px-4 py-3 text-neutral-800 dark:text-neutral-100 text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none transition"
            />
          </div>

          <!-- Short Description -->
          <div>
            <label for="project-desc" class="text-sm font-semibold text-neutral-700 dark:text-neutral-300 mb-2 block">Short Description <span class="text-xs font-normal text-neutral-400">(Optional)</span></label>
            <textarea
              id="project-desc"
              rows="3"
              placeholder="Briefly describe your RAG architecture, vector store used, and model choice..."
              class="w-full rounded-lg border border-neutral-300 dark:border-neutral-600 bg-bg-primary/50 dark:bg-bg-primary-dark/50 px-4 py-3 text-neutral-800 dark:text-neutral-100 text-sm focus:border-primary focus:ring-1 focus:ring-primary outline-none transition resize-none"
            ></textarea>
          </div>

          <!-- Status Indicator -->
          <div class="flex items-center justify-between p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/20">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider">Deployment Status</span>
            </div>
            <span class="text-xs font-medium text-emerald-700 dark:text-emerald-400">Ready to Submit</span>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button
              type="button"
              id="submit-btn"
              class="w-full flex justify-center items-center gap-2 px-6 py-4 rounded-xl bg-btn-primary hover:bg-btn-primary-hover text-white text-base font-semibold transition duration-300 hover:shadow-lg active:scale-[0.99] cursor-pointer"
            >
              <Send class="w-5 h-5" /> SUBMIT CHATBOT
            </button>
          </div>
        </form>
      </div>

      <!-- Success State (hidden initially) -->
      <div id="success-container" class="hidden rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-emerald-500/30 p-8 md:p-12 text-center mb-8" data-aos="fade-up-xs">
        <div class="w-16 h-16 bg-emerald-500/15 rounded-full flex items-center justify-center mx-auto mb-6 text-emerald-500">
          <CheckCircle class="w-10 h-10" />
        </div>
        <h2 class="text-3xl font-brand text-neutral-800 dark:text-neutral-100 mb-2">SUBMISSION RECEIVED</h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-8">Your chatbot submission has been recorded and queued for evaluation.</p>

        <div class="max-w-md mx-auto text-left rounded-lg bg-neutral-50 dark:bg-neutral-800/60 p-6 border border-neutral-200 dark:border-neutral-700 space-y-3">
          <div class="flex justify-between items-center text-xs">
            <span class="text-neutral-400">Status</span>
            <Badge variant="success">✓ Submitted</Badge>
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-neutral-400">Team</span>
            <span class="font-medium text-neutral-700 dark:text-neutral-200">Team Alpha</span>
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-neutral-400">Theme</span>
            <span class="font-medium text-neutral-700 dark:text-neutral-200">Coming Soon</span>
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-neutral-400">Chatbot URL</span>
            <a id="submitted-url-link" href="#" target="_blank" class="font-medium text-primary hover:underline flex items-center gap-1">
              <span id="submitted-url-text">https://...</span>
              <ExternalLink class="w-3 h-3" />
            </a>
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-neutral-400">Submitted At</span>
            <span id="submission-timestamp" class="font-mono text-neutral-600 dark:text-neutral-300">--:-- PM</span>
          </div>
        </div>

        <!-- Lock state note -->
        <div class="mt-6 flex items-center justify-center gap-2 text-xs text-neutral-400">
          <Lock class="w-3.5 h-3.5" />
          <span>Submission Locked — contact organizers to request resubmission</span>
        </div>
      </div>

      <!-- Guidelines Card -->
      <div class="rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 p-6 md:p-8">
        <h3 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-4 flex items-center gap-2">
          <FileText class="w-4 h-4 text-primary" /> Submission Guidelines
        </h3>
        <ul class="space-y-2.5 text-sm text-neutral-600 dark:text-neutral-300">
          <li class="flex items-start gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary mt-2 flex-shrink-0"></span>
            <span>Your chatbot must be publicly accessible via the provided URL without authentication wall.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary mt-2 flex-shrink-0"></span>
            <span>The chatbot should retrieve and generate answers strictly based on your assigned theme dataset.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary mt-2 flex-shrink-0"></span>
            <span>Test the deployment link in an incognito window before submitting to confirm accessibility.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary mt-2 flex-shrink-0"></span>
            <span>Theme evaluators will test accuracy, context relevance, latency, and UI experience.</span>
          </li>
        </ul>
      </div>

    </div>
  </div>
</Layout>

<script>
  const submitBtn = document.getElementById('submit-btn');
  const urlInput = document.getElementById('chatbot-url') as HTMLInputElement | null;
  const urlError = document.getElementById('url-error');
  const formContainer = document.getElementById('form-container');
  const successContainer = document.getElementById('success-container');
  const submittedUrlText = document.getElementById('submitted-url-text');
  const submittedUrlLink = document.getElementById('submitted-url-link') as HTMLAnchorElement | null;
  const submissionTimestamp = document.getElementById('submission-timestamp');

  submitBtn?.addEventListener('click', () => {
    const val = urlInput?.value.trim() || '';

    if (!val || (!val.startsWith('http://') && !val.startsWith('https://'))) {
      urlError?.classList.remove('hidden');
      urlInput?.focus();
      return;
    }

    urlError?.classList.add('hidden');

    // Populate success details
    if (submittedUrlText) submittedUrlText.textContent = val;
    if (submittedUrlLink) submittedUrlLink.href = val;
    if (submissionTimestamp) {
      submissionTimestamp.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }

    // Toggle view
    formContainer?.classList.add('hidden');
    successContainer?.classList.remove('hidden');
  });
</script>
