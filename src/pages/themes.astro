---
import PageHeader from "@/components/elements/PageHeader.astro";
import SectionHeader from "@/components/elements/SectionHeader.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Layout from "@/layouts/Layout.astro";
import {
	ArrowRight,
	BarChart,
	Brain,
	CheckCircle,
	Database,
	FileText,
	Globe,
	Lock,
	Search,
} from "@lucide/astro";

const themes = [
	{ num: "01", icon: FileText },
	{ num: "02", icon: Database },
	{ num: "03", icon: Globe },
	{ num: "04", icon: Brain },
	{ num: "05", icon: BarChart },
];

const selectionSteps = [
	{ num: "1", label: "Browse", desc: "Explore all five themes" },
	{ num: "2", label: "Select", desc: "Pick one that fits your team" },
	{ num: "3", label: "Confirm", desc: "Lock in your selection" },
	{ num: "4", label: "Receive", desc: "Get your theme dataset" },
];
---

<Layout
  title="Choose Your Theme — RAG Hackathon"
  description="Each team selects one of five themes. Your theme determines your dataset and evaluation."
>
  <div class="pt-8 pb-16 md:pb-24">
    <PageHeader
      title="Choose Your Theme"
      description="Each team selects one of five themes. Your theme determines your dataset and evaluation."
    />

    <!-- Theme Cards -->
    <section class="py-8 md:py-12 site-container">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {themes.map((theme, i) => (
          <div
            class="relative p-8 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border-2 border-dashed border-primary/15 dark:border-neutral-700 hover:shadow-md hover:-translate-y-1 transition-all duration-300 group"
            data-aos="fade-up-sm"
            data-aos-delay={i * 80}
            data-aos-once="true"
          >
            <!-- Theme Number Badge -->
            <div class="flex items-center justify-between mb-6">
              <Badge variant="primary">THEME {theme.num}</Badge>
              <div class="p-2 rounded-lg bg-primary/10 dark:bg-primary/20 opacity-50 group-hover:opacity-100 transition-opacity">
                <theme.icon class="w-5 h-5 text-primary" />
              </div>
            </div>

            <!-- Title -->
            <h3 class="text-2xl font-brand mb-3 text-neutral-800 dark:text-neutral-100">Coming Soon</h3>

            <!-- Description -->
            <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed mb-6">
              Theme details will be announced soon. Check back for the full theme description and requirements.
            </p>

            <!-- Details -->
            <div class="space-y-3 pt-4 border-t border-dashed border-primary/10 dark:border-neutral-700">
              <div class="flex items-center justify-between">
                <span class="text-xs text-neutral-400 dark:text-neutral-500 uppercase tracking-wider">Dataset</span>
                <span class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">Coming Soon</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs text-neutral-400 dark:text-neutral-500 uppercase tracking-wider">Difficulty</span>
                <span class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">Coming Soon</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs text-neutral-400 dark:text-neutral-500 uppercase tracking-wider">Evaluator</span>
                <span class="text-xs text-neutral-500 dark:text-neutral-400 font-medium">Coming Soon</span>
              </div>
            </div>

            <!-- View Dataset Button (Coming Soon state) -->
            <div class="mt-6">
              <Button url="javascript:void(0)" type="disabled" size="sm" className="w-full justify-center max-w-full">
                <Database size={14} /> View Dataset
              </Button>
            </div>
          </div>
        ))}

        <!-- 6th card: Info card -->
        <div
          class="p-8 rounded-xl bg-primary/5 dark:bg-primary/10 border border-primary/15 dark:border-primary/20 flex flex-col justify-center"
          data-aos="fade-up-sm"
          data-aos-delay={5 * 80}
          data-aos-once="true"
        >
          <Search class="w-8 h-8 text-primary mb-4" />
          <h4 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100 mb-2">One Theme Only</h4>
          <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
            Each team can select exactly <strong class="text-primary">one theme</strong>. Selection is final — once confirmed, your team receives the theme-specific dataset.
          </p>
        </div>
      </div>
    </section>

    <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"></div>

    <!-- How Selection Works -->
    <section class="py-16 md:py-24 site-container">
      <SectionHeader title="How Theme Selection Works" description="A simple four-step process from browsing to building." />
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-8 max-w-4xl mx-auto">
        {selectionSteps.map((step, i) => (
          <div
            class="flex flex-col items-center text-center gap-3 p-6 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700"
            data-aos="fade-up-sm"
            data-aos-delay={i * 100}
            data-aos-once="true"
          >
            <span class="text-3xl font-brand text-primary">{step.num}</span>
            <span class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 uppercase tracking-wide">{step.label}</span>
            <span class="text-xs text-neutral-500 dark:text-neutral-400">{step.desc}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="py-12 md:py-16 site-container">
      <div class="max-w-2xl mx-auto text-center rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 p-8 md:p-12" data-aos="fade-up-xs" data-aos-once="true">
        <Badge variant="primary" size="lg">Themes Coming Soon</Badge>
        <h2 class="text-2xl md:text-3xl font-brand mt-4 mb-4">Stay Tuned</h2>
        <p class="text-neutral-600 dark:text-neutral-300 mb-8 leading-relaxed">
          Themes will be announced soon. In the meantime, learn how the competition works.
        </p>
        <div class="flex justify-center">
          <Button url="/how-it-works" type="fill">How It Works <ArrowRight size={16} /></Button>
        </div>
      </div>
    </section>
  </div>
</Layout>
