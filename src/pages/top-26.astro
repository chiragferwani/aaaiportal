---
import PageHeader from "@/components/elements/PageHeader.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Layout from "@/layouts/Layout.astro";
import { teams } from "@/data/teams";
import { ArrowRight, Hash, Layers, Target, Users } from "@lucide/astro";

const totalMembers = teams.reduce((acc, team) => acc + team.members.length, 0);

const stats = [
  { icon: Users, label: "Teams Qualified", value: teams.length.toString() },
  { icon: Hash, label: "Members Per Team", value: "3-4" },
  { icon: Layers, label: "Total Participants", value: totalMembers.toString() },
  { icon: Target, label: "Available Themes", value: "5" },
];
---

<Layout title="Top 26 Teams — AI Odyssey presents: The LLM Design Workshop" description="The teams that qualified through Round 1 to advance to the RAG Build Challenge.">
  <div class="pt-8 pb-16 md:pb-24">
    <PageHeader
      title="Top 26 Teams"
      description="The teams that qualified through Round 1. These teams advance to the RAG Build Challenge."
    />

    <section class="site-container">
      <!-- Stats Section -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16" data-aos="fade-up-xs" data-aos-once="true">
        {stats.map((stat) => (
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700 flex flex-col items-center text-center gap-3">
            <div class="p-3 bg-primary/10 dark:bg-primary/20 rounded-lg">
              <stat.icon class="w-5 h-5 text-primary" />
            </div>
            <div>
              <div class="text-3xl font-brand text-neutral-800 dark:text-neutral-100">{stat.value}</div>
              <div class="text-xs text-neutral-500 dark:text-neutral-400 font-medium mt-1">{stat.label}</div>
            </div>
          </div>
        ))}
      </div>

      <!-- Leaderboard Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {teams.map((team, index) => {
          const accentBorder = "border-primary/10 dark:border-neutral-700";
          const badgeText = "QUALIFIED";
          const badgeVariant: 'success' | 'accent' | 'neutral' = "success";
          const rankColor = "text-primary";

          return (
            <div
              class={`rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border ${accentBorder} p-6 flex flex-col gap-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-md`}
              data-aos="fade-up-sm"
              data-aos-once="true"
              data-aos-delay={index < 9 ? index * 60 : 0}
            >
              <div class="flex justify-between items-start">
                <span class={`text-4xl font-brand ${rankColor}`}>
                  #{team.rank.toString().padStart(2, '0')}
                </span>
                <Badge variant={badgeVariant}>{badgeText}</Badge>
              </div>

              <div>
                <h3 class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">{team.name}</h3>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">RAG Build Challenge Qualifier</p>
              </div>

              <div class="pt-4 border-t border-dashed border-primary/10 dark:border-neutral-700">
                <p class="text-[10px] font-semibold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider mb-3">Team Members</p>
                <ul class="space-y-1.5">
                  {team.members.map((member) => (
                    <li class="flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-300">
                      <span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span>
                      {member}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })}
      </div>

      <!-- CTA -->
      <div class="text-center py-12 border-t border-dashed border-primary/10 dark:border-neutral-700" data-aos="fade-up-xs" data-aos-once="true">
        <h2 class="text-2xl md:text-3xl font-brand mb-2 text-neutral-800 dark:text-neutral-100">Qualified?</h2>
        <p class="text-neutral-600 dark:text-neutral-300 mb-6">Submit your deployed chatbot link for evaluation.</p>
        <div class="flex justify-center">
          <Button url="/submit" type="fill" size="lg">Submit Chatbot <ArrowRight size={18} /></Button>
        </div>
      </div>
    </section>
  </div>
</Layout>
